                    <label class="block text-sm font-medium text-stone-700 mb-1">ชื่อ-นามสกุล <span class="text-red-500">*</span></label>
                    <input type="text" id="custName" placeholder="กรอกชื่อ-นามสกุลจริง" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm">
