                        <input type="text" id="custSocial" placeholder="@username" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-1">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
                        <input type="tel" id="custPhone" placeholder="08xxxxxxxx" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-stone-700 mb-1">ที่อยู่จัดส่งสินค้า <span class="text-red-500">*</span></label>
                    <textarea id="custAddress" rows="3" placeholder="บ้านเลขที่ ถนน แขวง/ตำบล เขต/อำเภอ จังหวัด รหัสไปรษณีย์" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-stone-700 mb-1">วิธีการรับสินค้า <span class="text-red-500">*</span></label>
                    <select id="shippingMethod" onchange="calculateTotal()" class="w-full px-4 py-2 border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm bg-white font-medium">
                        <option value="delivery">📦 จัดส่งพัสดุ (+45 บาท)</option>
                        <option value="pickup">🤝 รับที่บูธงาน (ไม่บวกค่าส่ง)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Menu Catalog Images Display -->
        <div class="bg-white rounded-2xl shadow-md p-5 md:p-6 mb-6 border border-amber-100">
            <h2 class="text-lg font-bold text-stone-800 mb-3 flex items-center gap-2">
                <span>🖼️</span> ภาพเมนูสินค้าอ้างอิง
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="border rounded-xl overflow-hidden shadow-sm bg-stone-50">
                    <img src="image.png" alt="Menu 1" class="w-full h-auto object-cover">
                </div>
                <div class="border rounded-xl overflow-hidden shadow-sm bg-stone-50">
                    <img src="image_2.png" alt="Menu 2" class="w-full h-auto object-cover">
